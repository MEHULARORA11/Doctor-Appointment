# ========================================================
# Doctor Appointment Backend Environment Configuration
# ========================================================

# Runtime Environment (production / development)
NODE_ENV=production
PORT=5050

# PostgreSQL Connection String (Prisma)
# Neon / Supabase / Railway / Vercel Postgres / Local PostgreSQL
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doctor_appointment?schema=public"

# Frontend Application URL (Used for CORS and email links)
CLIENT_URL="http://localhost:3000"
CLIENT_LOCAL_URL="http://localhost:3000"
CLIENT__LOCAL_URL="http://localhost:3000"

# Backend Public & Local URLs (Used in email verification callbacks)
BACKEND_LIVE_URL="http://localhost:5050"
BACKEND_LOCAL_URL="http://localhost:5050"

# JWT Authentication Secrets & Expirations
JWT_SECRET="doctor_appointment_jwt_secret_key_2026_super_secure_random_string_93817491"
JWT_SCRET="doctor_appointment_jwt_secret_key_2026_super_secure_random_string_93817491"
JWT_EXPIRES_IN="7d"
JWT_EXPIRED_IN="7d"
JWT_REFRESH_SECRET="doctor_appointment_jwt_refresh_secret_key_2026_super_secure_random_string_82736192"
JWT_REFRESH_SCRET="doctor_appointment_jwt_refresh_secret_key_2026_super_secure_random_string_82736192"

# Default Doctor Credentials
DOCTOR_PASS="Doctor@123456"
DEFULT_ADMIN_DOCTOR="admin@doctorappointment.com"
DEFAULT_ADMIN_DOCTOR="admin@doctorappointment.com"

# Email Notifications (Nodemailer Gmail SMTP)
ADMIN_EMAIL="admin@doctorappointment.com"
GMAIL_APP_EMAIL="your-email@gmail.com"
EMAIL_PASS="your-16-digit-gmail-app-password"

# Cloudinary Storage Credentials (Used for prescription & profile image uploads)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="sample_cloudinary_api_secret"
CLOUND_NAME="demo"
API_KEY="123456789012345"
API_SECRET="sample_cloudinary_api_secret"

# Debugging
SHOW_ERROR_DETAILS=true
