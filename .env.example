# ========================================================
# Doctor Appointment Frontend Environment Configuration
# ========================================================

# Set to true to route API calls to local backend, or false to use live URL
REACT_APP_USE_LOCAL_API=false

# Production backend URL deployed on Vercel
# Replace with your actual backend Vercel deployment URL (e.g., https://doctor-appointment-api.vercel.app)
REACT_APP_API_BASE_URL=http://localhost:5050
REACT_APP_API_BASE_URL_LIVE=http://localhost:5050

# Local backend URL for local development
REACT_APP_API_BASE_URL_LOCAL=http://localhost:5050
